# Server Configuration
PORT=8080

# Database Configuration (Neon PostgreSQL)
# Example: postgres://user:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@your-host.neon.tech/your_db?sslmode=require

# Authentication
JWT_SECRET=replace-with-a-random-secret

# SMM Provider Configuration
TOPSMM_API_KEY=your-topsmm-api-key
TOPSMM_API_URL=https://topsmm.in/api/v2
SMM_CURRENCY=INR

# AI Configuration (Gemini)
GEMINI_API_KEY=your-gemini-api-key

# Google Auth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# URLs for local development
API_BASE_URL="http://localhost:8080"
FRONTEND_URL="http://localhost:3000"

# UPI Auto-Verify System
UPI_NOTIFY_KEY=replace-with-a-random-secret
UPI_IDS=your-upi-id@upi
